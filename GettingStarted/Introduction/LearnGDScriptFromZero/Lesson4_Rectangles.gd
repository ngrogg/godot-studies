func draw_corner():
    move_forward(200)
    turn_right(90)
    move_forward(200)

func draw_rectangle():
    move_forward(200)
    turn_right(90)
    move_forward(120)
    turn_right(90)
    move_forward(200)
    turn_right(90)
    move_forward(120)

func draw_bigger_rectangle():
    move_forward(220)
    turn_right(90)
    move_forward(260)
    turn_right(90)
    move_forward(220)
    turn_right(90)
    move_forward(260)
